{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.author_name,\n            p.author_hash,\n            p.title,\n            p.view_count,\n            p.like_count,\n            p.created_at,\n            (\n                SELECT COUNT(id)\n                FROM comments\n                WHERE post_id = p.id AND deleted_at IS NULL\n            ) AS \"comment_count!\"\n        FROM posts p\n        WHERE p.category_id = $1 AND p.deleted_at IS NULL\n        ORDER BY p.created_at DESC\n        LIMIT $2 OFFSET $3\n        ",
