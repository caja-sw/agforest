{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.name,\n            c.readonly,\n            (\n                SELECT COUNT(id)\n                FROM posts\n                WHERE category_id = c.id AND deleted_at IS NULL\n            ) AS \"post_count!\"\n        FROM categories c\n        WHERE c.id = $1\n        ",
